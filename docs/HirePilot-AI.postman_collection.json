              "script": {
                "exec": [
                  "pm.test('analyze queued -> 202', function () { pm.response.to.have.status(202); });",
                  "pm.test('analysisStatus becomes COMPLETED after poll', function () {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /resume-ai/:resumeId/analysis (poll until COMPLETED)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/resume-ai/{{resumeId}}/analysis",
              "host": ["{{baseUrl}}"],
              "path": ["resume-ai", "{{resumeId}}", "analysis"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('analysis endpoint -> 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('completed analysis has score fields', function () {",
                  "  var data = pm.response.json().data;",
                  "  if (data.analysisStatus === 'COMPLETED') {",
                  "    pm.expect(data).to.have.property('atsCompatibility');",
                  "    pm.expect(data).to.have.property('analysisScore');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }

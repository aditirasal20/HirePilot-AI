{
  "info": {
    "name": "HirePilot AI - Server API",
    "description": "Production-readiness test collection for the HirePilot AI backend. Base URL: http://localhost:5001/api/v1. Login sets `candidateToken` / `recruiterToken` collection variables automatically. Protected endpoints use the `Authorization: Bearer {{token}}` header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api/v1" },
    { "key": "candidateToken", "value": "" },
    { "key": "recruiterToken", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "resumeId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "interviewId", "value": "" },
    { "key": "matchId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('health returns 200 + success true', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
